# BigWigsMods/packager configuration (used by .github/workflows/release.yml).
# The addon lives in the OneKeyFishing/ folder of the repository; move-folders makes that folder the
# package. The rest of the repository root lands in the same folder, so `ignore` leaves out the tools, docs
# and project files (dotfiles are skipped by the packager itself; the AI tooling folders are listed anyway);
# `npm run check` keeps the list complete.
# The local equivalent is `npm run build`.
package-as: OneKeyFishing

move-folders:
  OneKeyFishing/OneKeyFishing: OneKeyFishing

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - CLAUDE.md
  - package.json
  - package-lock.json
  - tools
  - tests
  - docs
  - specs
  - dist
  - .claude
  - .specify

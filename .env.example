# Copy this file to `.env` (git-ignored) and set the path of the game's Interface/AddOns folder.
# Used by `npm run link`, `npm run unlink` and `npm run install-addon`.
#   Windows: WOW_ADDONS_DIR=D:\Games\World of Warcraft\_forever_\Interface\AddOns
#   macOS:   WOW_ADDONS_DIR=/Applications/World of Warcraft/_forever_/Interface/AddOns
WOW_ADDONS_DIR=
